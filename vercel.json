{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "env": {
    "NODE_OPTIONS": "--experimental-sqlite"
  },
  "build": {
    "env": {
      "NODE_OPTIONS": "--experimental-sqlite"
    }
  },
  "functions": {
    "api/index.js": {
      "includeFiles": "data/**",
      "excludeFiles": "{dist/**,src/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
